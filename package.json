{
  "name": "fittrack-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mobile",
    "backend",
    "shared",
    "tools/off-import"
  ],
  "overrides": {
    "fflate": "0.7.5",
    "azurite": {
      "@azure/ms-rest-js": {
        "form-data": "2.5.6"
      }
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build:backend": "npm run build --workspace=backend",
    "build:verify:backend": "npm run build:verify --workspace=backend",
    "typecheck": "npm run typecheck --workspace=backend --workspace=shared --workspace=mobile",
    "test:shared": "npm run test --workspace=shared",
    "test:backend": "npm run test --workspace=backend",
    "test:mobile": "npm run test --workspace=mobile",
    "test": "npm run test:shared ; npm run test:backend ; npm run test:mobile",
    "analyze:off": "npm run analyze:off:tsx --workspace=@fittrack/off-import",
    "export:off": "npm run export:off --workspace=@fittrack/off-import",
    "import:cosmos": "npm run import:cosmos --workspace=@fittrack/off-import",
    "test:scripts": "node --test scripts/migrate-food-products.test.mjs scripts/migrate-alpha-data.test.mjs scripts/check-test-parity.test.mjs",
    "check:encoding": "node scripts/check-encoding.mjs"
  }
}
