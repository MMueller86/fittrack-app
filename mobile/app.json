{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "owner": "michi01mueller",
    "scheme": "fittrack",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/fittrack_app_icon_master_v1.png",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android",
      "ios"
    ],
    "splash": {
      "image": "./assets/brand/fittrack_splash_logo_master_v1.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F0C"
    },
    "android": {
      "package": "com.fittrack.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/fittrack_app_icon_master_v1.png",
        "backgroundColor": "#0B0F0C"
      }
    },
    "ios": {
      "bundleIdentifier": "com.fittrack.app",
      "supportsTablet": false
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-web-browser",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "cda0994d-6f68-4394-b82b-7a70600974c6"
      }
    }
  }
}
