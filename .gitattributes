# Normalize line endings to LF for all text files
* text=auto eol=lf

# Source files
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mts       text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.bicep     text eol=lf
*.bicepparam text eol=lf
*.sh        text eol=lf
*.ps1       text eol=crlf

# Binary files — no normalization
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.apk       binary
*.aab       binary
*.keystore  binary
