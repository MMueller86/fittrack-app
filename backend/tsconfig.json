{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "..",
    "sourceMap": true,
    "paths": {
      "@fittrack/shared": ["../shared/index.ts"],
      "@fittrack/shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-utils/**"]
}
