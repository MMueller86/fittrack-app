{
  "name": "@fittrack/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/backend/src/index.js",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": "12.2.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/copy-instagram-assets.mjs",
    "build:verify": "npm run build && node scripts/verify-build.mjs",
    "build:watch": "tsc --project tsconfig.json --watch",
    "start": "node scripts/wait-for-azurite.mjs && func start",
    "dev": "node scripts/dev.mjs",
    "storage:start": "node scripts/storage.mjs",
    "copy:instagram-assets": "node scripts/copy-instagram-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render:recipe-details-template": "npm run build && node scripts/render-recipe-details-template.mjs",
    "render:gefluegelfrikadellen-details-template": "npm run build && node scripts/render-gefluegelfrikadellen-details-template.mjs",
    "render:nine-ingredients-details-template": "npm run build && node scripts/render-nine-ingredients-details-template.mjs",
    "render:twenty-ingredients-details-template": "npm run build && node scripts/render-twenty-ingredients-details-template.mjs",
    "test:startup": "node --test scripts/dev.test.mjs scripts/storage.test.mjs scripts/wait-for-azurite.test.mjs scripts/run-eval.test.mjs scripts/functions-baseline.test.mjs",
    "test:watch": "vitest",
    "test:functions-smoke": "node scripts/functions-smoke.mjs",
    "test:contract": "vitest run --config vitest.contract.config.mts",
    "migrate:insight-weight-trend": "node scripts/migrate-insight-weight-trend.mjs",
    "render:instagram-reference": "node scripts/render-golden.mjs",
    "test:eval": "node scripts/run-eval.mjs",
    "verify:daily-insight-prompt": "node --test scripts/verify-daily-insight-prompt.test.mjs && node scripts/verify-daily-insight-prompt.mjs",
    "emulator:start": "powershell -ExecutionPolicy Bypass -File scripts/start-cosmos-emulator.ps1",
    "emulator:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-cosmos-emulator.ps1"
  },
  "dependencies": {
    "@azure/ai-form-recognizer": "^5.1.0",
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.17.0",
    "@azure/storage-blob": "^12.34.0",
    "@azure/storage-queue": "^12.32.0",
    "@napi-rs/canvas": "~1.0.13",
    "@tabler/icons": "~3.46.0",
    "hyphen": "^1.14.1",
    "jose": "^6.2.14",
    "lucide-static": "~1.46.0",
    "openai": "^7.45.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/typescript6": "~6.0.2",
    "azurite": "^3.37.0",
    "pixelmatch": "~7.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
