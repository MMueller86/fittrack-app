{
  "name": "@fittrack/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/backend/src/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:verify": "tsc --project tsconfig.json && node -e \"require('./dist/backend/src/index.js')\"",
    "build:watch": "tsc --project tsconfig.json --watch",
    "start": "func start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.mts",
    "emulator:start": "powershell -ExecutionPolicy Bypass -File scripts/start-cosmos-emulator.ps1",
    "emulator:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-cosmos-emulator.ps1"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.1",
    "@azure/functions": "^4.5.0",
    "@azure/storage-blob": "^12.25.0",
    "openai": "^4.104.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  }
}
