{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/.well-known/assetlinks.json",
      "headers": {
        "Content-Type": "application/json",
        "Cache-Control": "public, max-age=300"
      }
    },
    {
      "route": "/auth/callback/alpha",
      "rewrite": "/auth/callback/alpha.html",
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "route": "/auth/callback/dev",
      "rewrite": "/auth/callback/dev.html",
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "route": "/auth/relay.js",
      "headers": { "Cache-Control": "no-store" }
    }
  ],
  "globalHeaders": {
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
